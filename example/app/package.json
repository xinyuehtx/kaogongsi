    "@tengxiaohtx/compare": "workspace:*",
    "@tengxiaohtx/report": "workspace:*",
    "@tengxiaohtx/report-llm": "workspace:*",
    "@tengxiaohtx/plugin-core": "workspace:*",
    "@tengxiaohtx/ingest": "workspace:*",
    "@tengxiaohtx/connector-mock": "workspace:*",
    "@tengxiaohtx/connector-example": "workspace:*",
