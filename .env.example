# 考功司 · 环境变量示例（复制为 .env 后按需修改）
# docker compose 会读取本文件

# 必改：JWT 密钥
KAOGONGSI_JWT_SECRET=change-me-in-prod

# 防腐层：Postgres/Prisma（DB）+ Redis（缓存）
DATABASE_URL=postgresql://kaogongsi:kaogongsi@db:5432/kaogongsi
REDIS_URL=redis://cache:6379

# 可选：真实 LLM（对比报告）——留空则离线确定性模板
KAOGONGSI_LLM_BASE_URL=
KAOGONGSI_LLM_API_KEY=
KAOGONGSI_LLM_MODEL=

# 可选：轨迹接入（RFC-006）。file:/trajectories 或 http(s)://host/api/traces
KAOGONGSI_INGEST=
KAOGONGSI_PARSERS=
