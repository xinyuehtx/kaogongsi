{
  "name": "kaogongsi",
  "version": "0.0.0",
  "private": true,
  "description": "端到端 Agent 评测框架 —— 归因决策机（monorepo）",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --filter=!@tengxiaohtx/e2e",
    "test": "turbo run test --filter=!@tengxiaohtx/e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck --filter=!@tengxiaohtx/e2e",
    "dev": "turbo run dev --filter=!@tengxiaohtx/e2e",
    "e2e": "pnpm --filter @tengxiaohtx/e2e test",
    "stack:up": "docker compose up --build",
    "stack:down": "docker compose down",
    "stack:clean": "docker compose down -v"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
